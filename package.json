{
  "name": "appointment-scheduler-tcc",
  "version": "1.0.0",
  "private": true,
  "description": "CRUD de agendamentos para o Cenário A do experimento de Vibe Coding",
  "main": "src/main/server.js",
  "engines": {
    "node": "24.22.2"
  },
  "scripts": {
    "start": "node src/main/server.js",
    "dev": "nodemon src/main/server.js",
    "test": "node --test",
    "test:coverage": "node --experimental-test-coverage --test --test-coverage-include=src/**/*.js",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run test:coverage"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "dotenv": "18.0.9",
    "ejs": "7.0.2",
    "express": "5.3.0",
    "helmet": "8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "nodemon": "3.1.14",
    "prettier": "3.9.10",
    "supertest": "7.3.1"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}
